{
  "name": "dsh-model-avail",
  "version": "0.2.0",
  "description": "Probe which models actually answer, then order the model picker by how many models each provider really serves.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "scripts/install.mjs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "model-availability"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node --test test/client.test.mjs test/host.test.mjs test/install.test.mjs",
    "install-profile": "node scripts/install.mjs",
    "uninstall-profile": "node scripts/install.mjs --uninstall"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-client-runtime": "*",
    "@deepseek-ai/dsh-client-ui-model-selection": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-runtime": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-model-selection": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-model-selection"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shino113-1/dsh-model-avail.git"
  },
  "bugs": {
    "url": "https://github.com/Shino113-1/dsh-model-avail/issues"
  },
  "homepage": "https://github.com/Shino113-1/dsh-model-avail#readme"
}
